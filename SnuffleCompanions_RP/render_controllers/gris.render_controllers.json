        },
        {
          "vaskor": "q.property('gris:vaskor') == 1"
        },
        {
          "tryffel": "q.property('gris:bar') == 1"
        },
        {
          "lera": "q.property('gris:lerig') == 1"
        }
      ]
    }
  }
}