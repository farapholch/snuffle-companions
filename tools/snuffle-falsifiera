#!/usr/bin/env python3
"""Provar att testets STATISKA spärrar faktiskt faller.

En spärr som aldrig sett ett fel är inte bevisad — den kan lika gärna vara en
rad som alltid säger ja. Det här verktyget bryter EN sak i taget i en kopia av
paketet och kontrollerar att rätt spärr klagar på rätt sak.

Två gånger har det här provet hittat fel i SIG SJÄLVT i stället för i spärrarna,
och båda är värda att minnas:

  * `open(f, "w")` trunkerar filen INNAN argumentet `open(f).read()` hinner köra.
    Provet tömde generatorn och rapporterade "BOKBAR hittades inte", vilket såg
    ut som ett hål i spärren.
  * "mountain" ÄR en giltig biomtagg i motorn (den har 66 stycken). Ett prov som
    använder en giltig tagg provar ingenting. Använd "mountains".

    python3 tools/snuffle-falsifiera
"""
import json, os, re, shutil, subprocess, sys, tempfile

BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
KOPIA = "/tmp/snuffle-falsifiering"
BP = f"{KOPIA}/SnuffleCompanions_BP"
RP = f"{KOPIA}/SnuffleCompanions_RP"


def strukturgrinden():
    """Plockar ut strukturstegets python ur snuffle-test.

    KODEN LÄSES UR TESTET, den kopieras inte hit. En kopia skulle glida isär
    från originalet, och då provar det här verktyget en spärr som inte längre är
    den som körs skarpt — vilket är sämre än att inte prova alls."""
    rader = open(f"{BASE}/tools/snuffle-test", encoding="utf-8").read().splitlines()
    start = next(i for i, r in enumerate(rader) if r.startswith('STRUKT=$(python3 - "$SRC"'))
    slut = next(i for i in range(start + 1, len(rader)) if rader[i] == "PY")
    fil = tempfile.NamedTemporaryFile("w", suffix=".py", delete=False, encoding="utf-8")
    fil.write("\n".join(rader[start + 1:slut]))
    fil.close()
    return fil.name


def farsk():
    shutil.rmtree(KOPIA, ignore_errors=True)
    shutil.copytree(BASE, KOPIA)


def kor(grind):
    ut = subprocess.run([sys.executable, grind, KOPIA],
                        capture_output=True, text=True).stdout
    # UUID-KROCKEN MOT ORIGINALET ÄR VÄNTAD. Kopian delar per definition uuid med
    # paketet den kopierades från; det är spärren som fungerar, men det är inte
    # det som provas här.
    return [r for r in ut.splitlines() if r and not r.startswith("uuid ")]


def byt(sokvag, fran, till):
    d = open(sokvag, encoding="utf-8").read()
    open(sokvag, "w", encoding="utf-8").write(d.replace(fran, till))


def jsonfix(sokvag, f):
    d = json.load(open(sokvag)); f(d); json.dump(d, open(sokvag, "w"), indent=2)


# ANSIKTSPROVEN MÅSTE MÅLA I TEXTUREN. Ansiktsspärren läser PNG-pixlar, inte
# JSON, så ett prov som bara ändrar en fil kan aldrig få den att falla — och en
# spärr som ingen kan fälla är inte bevisad.
sys.path.insert(0, "/opt/purrfect-companions")
import render_regression as rr


def _framsidan(ras, valj):
    """Skallens eller trynskivans framsida i en ras textur, som (px, rect)."""
    geos = json.load(open(f"{RP}/models/entity/gris.geo.json"))["minecraft:geometry"]
    d = json.load(open(f"{RP}/entity/{ras}.json"))["minecraft:client_entity"]["description"]
    geo = next(g for g in geos if g["description"]["identifier"] == d["geometry"]["default"])
    kuber = next(b for b in geo["bones"] if b["name"] == "head")["cubes"]
    kub = valj(kuber)
    u, v = kub["uv"]; b_, h_, dd = kub["size"]
    w, h, px = rr.read_png(f"{RP}/{d['textures']['default']}.png")
    return (w, h, px), f"{RP}/{d['textures']['default']}.png", rr.faces(u, v, b_, h_, dd)["north"]


SKALLE = lambda k: max(k, key=lambda c: c["size"][0] * c["size"][1])
SKIVA = lambda k: min(k, key=lambda c: c["size"][2])


def mala_over(ras, valj, intervall=None):
    """Målar framsidan enfärgad — hela ytan, eller bara vissa kolumner
    (intervall i UV-ENHETER från ytans vänsterkant). Arket är tätare än
    geometrin sedan v1.4.0, så koordinaterna skalas med k."""
    (w, h, px), fil, (fx, fy, fw, fh) = _framsidan(ras, valj)
    geos = json.load(open(f"{RP}/models/entity/gris.geo.json"))["minecraft:geometry"]
    k = w / geos[0]["description"]["texture_width"]
    ax, ay = int(fx * k + 0.999), int(fy * k + 0.999)
    bx, by = int((fx + fw) * k + 1e-6), int((fy + fh) * k + 1e-6)
    grund = px[ay][ax]
    for y in range(ay, by):
        for x in range(ax, bx):
            kol = (x + 0.5 - fx * k) / k
            if intervall is None or any(a <= kol < b for a, b in intervall):
                px[y][x] = grund
    rr.write_png(fil, w, h, px)


PROV = [
